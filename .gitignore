# Rust build output
/target/

# Chat database and per-run turn logs (saved chats, and API keys saved with /provider add)
/logs/

# Local provider files hold API keys (only the .example templates are tracked)
/providers/*.provider

# Files the model writes while chatting (workspace/ is the chat's working directory)
/workspace/*
!/workspace/README.md

# Python bytecode
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
